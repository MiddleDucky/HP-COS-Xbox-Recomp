# Writes build_info.h for the run log's first line: which commit of the port and of the toolkit this exe was built
# from ("-dirty" with uncommitted changes) and when. Run on every build by the hpcos_build_info target
# (CMakeLists.txt), not at configure time, so the commits are never a reconfigure behind; the header is rewritten
# only when its text changes.
#   cmake -DPORT=<port dir> -DTOOLKIT=<xboxrecomp dir> -DOUT=<header> -P build_info.cmake
function(git_rev dir out)
    execute_process(COMMAND git -C "${dir}" describe --always --dirty --abbrev=7
                    OUTPUT_VARIABLE rev OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0 OR rev STREQUAL "")
        set(rev "unknown")
    endif()
    set(${out} "${rev}" PARENT_SCOPE)
endfunction()

git_rev("${PORT}" port_rev)
git_rev("${TOOLKIT}" toolkit_rev)
# the date only: with the minute in it every build would rewrite the header and rebuild main.c
string(TIMESTAMP built "%Y-%m-%d")
set(text "// generated by tools/build_info.cmake\n#define HPCOS_GIT \"${port_rev}\"\n#define XBOXRECOMP_GIT \"${toolkit_rev}\"\n#define HPCOS_BUILT \"${built}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
